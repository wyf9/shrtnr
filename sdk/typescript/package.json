  "repository": {
    "type": "git",
    "url": "git+https://github.com/wyf9/shrtnr.git",
    "directory": "sdk/typescript"
  },
  "keywords": [
    "url-shortener",
    "link-shortener",
    "short-url",
    "shorten-url",
    "shrtnr",
    "cloudflare-workers",
    "cloudflare-d1",
    "sdk",
    "typescript",
    "link-management",
    "click-analytics",
    "custom-slug"
  ],
